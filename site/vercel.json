{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/rullino", "destination": "/" },
    { "source": "/privacy", "destination": "/" },
    { "source": "/elimina-account", "destination": "/" },
    { "source": "/contatti", "destination": "/" }
  ],
  "redirects": [
    { "source": "/delete-account", "destination": "/elimina-account", "permanent": true }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; script-src 'self'; frame-ancestors 'none'" }
    ]},
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
